# Paths excluded from the Cloudflare Workers static-assets upload.
# wrangler scans the assets directory (the repo root) and rejects any single
# file >25 MiB. Git internals contain the large media history (a ~110 MiB pack),
# so .git must be excluded or the deploy fails with "Asset too large".
# Patterns use .gitignore syntax.

# Git internals (the cause of the "Asset too large" 110 MiB pack error)
.git

# Wrangler's own files / config (not part of the site)
.gitignore
.assetsignore
wrangler.jsonc
wrangler.toml
node_modules

# Editor / OS cruft
.DS_Store
**/.DS_Store

# Internal docs — not served to users
*.md

# Archived originals kept for reversibility, but not served (saves ~35 MB)
assets/_archive
